# Copie para .env e preencha. Nunca versione o .env.

# WhatsApp da 2L (somente dígitos, com DDI+DDD). Ex.: 5561994415050
VITE_WHATSAPP_NUMBER=5561994415050

# URL pública do site (sitemap, Open Graph). Defina quando o domínio existir.
VITE_SITE_URL=

# Supabase (Fase 2). Chave ANON é pública por design; a segurança vem do RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mapbox (Fase 4). Token PÚBLICO (pk.*) restrito por domínio no painel da Mapbox.
VITE_MAPBOX_TOKEN=
